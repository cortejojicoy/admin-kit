# dependencies
node_modules/
.pnp
.pnp.js
.yarn/

# build output — published from CI/local but never committed
dist/
*.tsbuildinfo

# logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# env / secrets
.env
.env.*
!.env.example

# editor / OS
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
.DS_Store
Thumbs.db

# coverage / tests
coverage/
.nyc_output/

# caches
.cache/
.turbo/
.next/
.eslintcache

# package manager artifacts
.pnpm-store/

# examples: source and generated docs are committed; build output is not
examples/*/node_modules
examples/*/.next
examples/*/dist
examples/*/next-env.d.ts
examples/*/tsconfig.tsbuildinfo

# local credentials scratch file — never commit
creds
creds.*

# python bytecode from tool/
__pycache__/
*.pyc
